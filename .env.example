# Environment Variables for AI Context Scraper Actor

# Apify Configuration
APIFY_TOKEN=your_apify_token_here
APIFY_DEFAULT_DATASET_ID=default
APIFY_DEFAULT_KEY_VALUE_STORE_ID=default

# GitHub Configuration (Optional - for authenticated code search)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Actor Configuration
MAX_SOURCES=15
CHUNK_SIZE=500
ENABLE_CACHE=true

# Logging Configuration
LOG_LEVEL=INFO

# Rate Limiting (requests per second)
RATE_LIMIT_RPS=10

# Timeout Configuration (seconds)
REQUEST_TIMEOUT=30
TOTAL_TIMEOUT=300

# Model Configuration (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Security
# Set to true in production to enforce HTTPS
ENFORCE_HTTPS=false

# StackOverflow API Configuration
STACKOVERFLOW_MAX_RESULTS=5
STACKOVERFLOW_MIN_SCORE=5

# GitHub Search Configuration
GITHUB_MAX_REPOS=10
GITHUB_MAX_CODE_RESULTS=20

# LLM Synthesis (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=arcee-ai/trinity-large-preview:free
